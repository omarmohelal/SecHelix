/.agents/skills/            @omarmohelal

# Contract surface: schemas define what counts as valid evidence and findings.
/schemas/                   @omarmohelal

# Hypothesis catalog: the families x lenses model that drives review coverage.
/catalog/                   @omarmohelal

# Release gates: policy files decide what blocks a release.
/policies/                  @omarmohelal

