{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sechelix.dev/schemas/report-v1.schema.json",
  "title": "SecHelix canonical report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "scope_id",
    "mode",
    "generated_at",
    "coverage",
    "tools",
    "evidence",
    "findings",
    "rejected_false_positives",
    "blocked_checks",
    "release_recommendation",
    "redaction_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report_id": {
      "type": "string",
      "pattern": "^REPORT-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^SCOPE-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "mode": {
      "enum": [
        "STATIC",
        "LOCAL",
        "STAGING",
        "PRODUCTION_SAFE"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_version",
        "APPLICABLE",
        "NOT_APPLICABLE",
        "UNKNOWN",
        "BLOCKED",
        "TOTAL",
        "integrity_critical_unknown"
      ],
      "properties": {
        "catalog_version": {
          "type": "string",
          "pattern": "^2\\.[0-9]+$"
        },
        "APPLICABLE": {
          "type": "integer",
          "minimum": 0
        },
        "NOT_APPLICABLE": {
          "type": "integer",
          "minimum": 0
        },
        "UNKNOWN": {
          "type": "integer",
          "minimum": 0
        },
        "BLOCKED": {
          "type": "integer",
          "minimum": 0
        },
        "TOTAL": {
          "const": 546
        },
        "integrity_critical_unknown": {
          "type": "integer",
          "minimum": 0,
          "description": "Applicable integrity-critical hypotheses whose outcome is still UNKNOWN or BLOCKED."
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "purpose"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence-v1.schema.json"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding-v1.schema.json"
      }
    },
    "rejected_false_positives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blocked_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SHX-[A-Z][A-Z0-9]{1,11}-L[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "release_recommendation": {
      "enum": [
        "PASS",
        "PASS_WITH_KNOWN_RISK",
        "BLOCKED",
        "INCOMPLETE"
      ]
    },
    "redaction_summary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "deployment_state": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Deployment state of the reviewed build; policies may forbid specific states."
    },
    "target_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "working_tree"
      ],
      "description": "The exact tree this report inspected. A report is stale for any other revision.",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "working_tree": {
          "enum": [
            "CLEAN",
            "DIRTY"
          ],
          "description": "DIRTY means uncommitted changes were present, so the commit alone does not identify what was inspected."
        },
        "dirty_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sechelix_version",
        "started_at",
        "completed_at"
      ],
      "description": "Provenance of the run that produced this report.",
      "properties": {
        "sechelix_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sechelix_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "agent_host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "verification_depth": {
          "enum": [
            "NONE",
            "SELF_REVIEW",
            "INDEPENDENT",
            "INDEPENDENT_MULTI_MODEL"
          ],
          "description": "How material findings were challenged."
        }
      }
    }
  }
}
