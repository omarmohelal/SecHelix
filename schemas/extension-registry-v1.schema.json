{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sechelix.dev/schemas/extension-registry-v1.schema.json",
  "title": "SecHelix curated extension registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "policy", "extensions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {"const": "SecHelix"},
    "policy": {"type": "string", "minLength": 20},
    "extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifest", "lifecycle", "added_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
          "manifest": {"type": "string", "pattern": "^extensions/community/[a-z][a-z0-9-]{2,63}/extension\\.json$"},
          "lifecycle": {"enum": ["COMMUNITY", "INCUBATING", "OFFICIAL", "DEPRECATED"]},
          "added_at": {"type": "string", "format": "date-time"},
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewed_at", "reviewers", "fixture_proof", "decision"],
            "properties": {
              "reviewed_at": {"type": "string", "format": "date-time"},
              "reviewers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
              "fixture_proof": {"type": "string", "pattern": "^https://"},
              "decision": {"type": "string", "minLength": 20, "maxLength": 400}
            }
          }
        }
      }
    }
  }
}
