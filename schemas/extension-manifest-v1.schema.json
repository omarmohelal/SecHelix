{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sechelix.dev/schemas/extension-manifest-v1.schema.json",
  "title": "SecHelix community extension manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "summary", "extension_type", "lifecycle", "compatibility", "entrypoints", "capabilities", "permissions", "safety", "author", "repository", "license", "documentation", "tests", "risk_notes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "name": {"type": "string", "minLength": 3, "maxLength": 80},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "summary": {"type": "string", "minLength": 20, "maxLength": 240},
    "extension_type": {"enum": ["ADAPTER", "CATALOG_PACK", "EVAL_PACK", "POLICY_PACK", "REPORTER", "SPECIALIST", "INTEGRATION"]},
    "lifecycle": {"const": "COMMUNITY"},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sechelix"],
      "properties": {"sechelix": {"type": "string", "minLength": 1, "maxLength": 40}}
    },
    "entrypoints": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "filesystem", "subprocess", "secrets"],
      "properties": {
        "network": {"enum": ["NONE", "OUTBOUND_DECLARED"]},
        "filesystem": {"enum": ["NONE", "READ_SCOPED", "WRITE_SCOPED"]},
        "subprocess": {"enum": ["NONE", "DECLARED"]},
        "secrets": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_mode", "destructive_actions", "production_mutation", "evidence_contract", "data_handling"],
      "properties": {
        "default_mode": {"enum": ["STATIC", "LOCAL_SAFE", "STAGING_SAFE"]},
        "destructive_actions": {"const": false},
        "production_mutation": {"const": false},
        "evidence_contract": {"const": true},
        "data_handling": {"type": "string", "minLength": 20, "maxLength": 320}
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "url"],
      "properties": {
        "handle": {"type": "string", "minLength": 2, "maxLength": 80},
        "url": {"type": "string", "pattern": "^https://"}
      }
    },
    "repository": {"type": "string", "pattern": "^https://"},
    "license": {"type": "string", "minLength": 2, "maxLength": 80},
    "documentation": {"type": "string", "pattern": "^https://"},
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "fixtures", "expected_contract"],
      "properties": {
        "command": {"type": "string", "minLength": 3, "maxLength": 240},
        "fixtures": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}},
        "expected_contract": {"enum": ["evidence-v1", "finding-v1", "report-v1", "catalog-v2", "policy-v1", "none"]}
      }
    },
    "risk_notes": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 12, "maxLength": 240}}
  }
}
