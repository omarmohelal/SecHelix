{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sechelix.dev/schemas/research-packet-v1.schema.json",
  "title": "SecHelix live research packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "research_id", "trigger", "question", "checked_at", "subject",
    "claim", "sources", "code_evidence", "safe_reproduction", "confidence", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "research_id": {"type": "string", "pattern": "^RSR-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "trigger": {
      "enum": [
        "UNKNOWN_PACKAGE", "NEW_CVE", "RECENT_FRAMEWORK_CHANGE", "CLOUD_OR_PROVIDER_CHANGE",
        "UNFAMILIAR_BEHAVIOR", "CONFLICTING_EVIDENCE", "MANUAL_RESEARCH"
      ]
    },
    "question": {"type": "string", "minLength": 12, "maxLength": 500},
    "checked_at": {"type": "string", "format": "date-time"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"type": "string", "minLength": 1, "maxLength": 160},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "ecosystem": {"type": "string", "minLength": 1, "maxLength": 80},
        "advisory_id": {"type": "string", "minLength": 3, "maxLength": 100}
      }
    },
    "claim": {"type": "string", "minLength": 12, "maxLength": 1200},
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "url", "retrieved_at", "relation", "official_advisory", "exact_version_match"
        ],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
          "url": {"type": "string", "pattern": "^https://"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "published_at": {"type": "string", "format": "date-time"},
          "relation": {"enum": ["SUPPORTS", "CONTRADICTS", "CONTEXT"]},
          "official_advisory": {"type": "boolean"},
          "exact_version_match": {"type": "boolean"},
          "note": {"type": "string", "minLength": 8, "maxLength": 500}
        }
      }
    },
    "code_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "evidence_refs"],
      "properties": {
        "present": {"type": "boolean"},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      }
    },
    "safe_reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "evidence_refs"],
      "properties": {
        "performed": {"type": "boolean"},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      }
    },
    "confidence": {"enum": ["UNVERIFIED", "SUPPORTED", "HIGH_CONFIDENCE", "CONFIRMED"]},
    "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 8, "maxLength": 500}}
  }
}
