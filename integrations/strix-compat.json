  },
  "policy": {
    "untested_version": "BLOCK",
    "missing_required_flag": "BLOCK",
    "partial_run": "BLOCK",
    "out_of_scope_reported_endpoint": "BLOCK",
    "scanner_verdict_authority": "NONE"
  },
  "notes": [
    "This pin records the exact upstream revision exercised by the SecHelix compatibility suite.",
    "A newer Strix version is not considered unsafe; it is considered untested until this contract and tests are deliberately updated.",
    "Strix findings remain CANDIDATE/UNASSESSED until independently reproduced and verified by SecHelix."
  ]
}
