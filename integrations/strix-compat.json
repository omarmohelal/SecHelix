{
  "schema": "sechelix-strix-compatibility-v1",
  "engine": "strix",
  "upstream_repository": "https://github.com/usestrix/strix",
  "package": "strix-agent",
  "tested_version": "1.6.2",
  "tested_upstream_commit": "007ed1a94e7dbf7b096c81e5b0354533ce94e0db",
  "contract": "strix-cli-v1",
  "required_cli_flags": [
    "--non-interactive",
    "--target",
