{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sechelix.dev/schemas/evidence-v1.schema.json",
  "title": "SecHelix evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "kind", "status", "source", "summary", "environment", "artifacts", "redactions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_id": {"type": "string", "pattern": "^EV-[A-Z0-9][A-Z0-9._-]{2,95}$"},
    "kind": {"enum": ["OBSERVATION", "TOOL_OUTPUT", "REPRODUCTION", "VERIFICATION", "REMEDIATION", "REGRESSION", "CONTEXT"]},
    "status": {"enum": ["RAW", "NORMALIZED", "CONFIRMED", "REJECTED"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "collected_at", "provenance"],
      "properties": {
        "type": {"enum": ["HUMAN", "MODEL", "SCANNER", "TEST", "REPOSITORY", "RUNTIME", "PROVIDER"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "invocation": {"type": "string", "minLength": 1},
        "collected_at": {"type": "string", "format": "date-time"},
        "provenance": {"type": "string", "minLength": 1}
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "details": {"type": "string", "minLength": 1},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "symbol": {"type": "string", "minLength": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "scope_id", "target_id"],
      "properties": {
        "mode": {"enum": ["STATIC", "LOCAL", "STAGING", "PRODUCTION_SAFE"]},
        "scope_id": {"type": "string", "pattern": "^SCOPE-[A-Z0-9][A-Z0-9._-]{2,63}$"},
        "target_id": {"type": "string", "pattern": "^TGT-[A-Z0-9][A-Z0-9._-]{1,63}$"}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "media_type", "sha256", "locator"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "redactions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "related_hypothesis_ids": {"type": "array", "items": {"type": "string", "pattern": "^SHX-[A-Z][A-Z0-9]{1,11}-L[0-9]{2}$"}, "uniqueItems": true}
  }
}
