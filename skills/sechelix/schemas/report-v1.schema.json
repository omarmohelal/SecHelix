{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sechelix.dev/schemas/report-v1.schema.json",
  "title": "SecHelix canonical report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "scope_id", "mode", "generated_at", "coverage", "tools", "evidence", "findings", "rejected_false_positives", "blocked_checks", "release_recommendation", "redaction_summary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"type": "string", "pattern": "^REPORT-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "scope_id": {"type": "string", "pattern": "^SCOPE-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "mode": {"enum": ["STATIC", "LOCAL", "STAGING", "PRODUCTION_SAFE"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_version", "APPLICABLE", "NOT_APPLICABLE", "UNKNOWN", "BLOCKED", "TOTAL"],
      "properties": {
        "catalog_version": {"type": "string", "pattern": "^2\\.[0-9]+$"},
        "APPLICABLE": {"type": "integer", "minimum": 0},
        "NOT_APPLICABLE": {"type": "integer", "minimum": 0},
        "UNKNOWN": {"type": "integer", "minimum": 0},
        "BLOCKED": {"type": "integer", "minimum": 0},
        "TOTAL": {"const": 546}
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "purpose"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "evidence-v1.schema.json"}},
    "findings": {"type": "array", "items": {"$ref": "finding-v1.schema.json"}},
    "rejected_false_positives": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "blocked_checks": {"type": "array", "items": {"type": "string", "pattern": "^SHX-[A-Z][A-Z0-9]{1,11}-L[0-9]{2}$"}, "uniqueItems": true},
    "release_recommendation": {"enum": ["PASS", "PASS_WITH_KNOWN_RISK", "BLOCKED", "INCOMPLETE"]},
    "redaction_summary": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
