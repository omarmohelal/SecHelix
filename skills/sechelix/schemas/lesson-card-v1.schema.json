{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sechelix.dev/schemas/lesson-card-v1.schema.json",
  "title": "SecHelix lesson card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "lesson_id", "title", "updated_at", "domains", "summary",
    "detection_signals", "safe_local_tests", "false_positive_traps", "remediation_patterns",
    "regression_proof", "mapping_node_ids", "source_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "lesson_id": {"type": "string", "pattern": "^LC-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 160},
    "updated_at": {"type": "string", "format": "date-time"},
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"}
    },
    "summary": {"type": "string", "minLength": 40, "maxLength": 1200},
    "detection_signals": {"$ref": "#/$defs/nonEmptyNotes"},
    "safe_local_tests": {"$ref": "#/$defs/nonEmptyNotes"},
    "false_positive_traps": {"$ref": "#/$defs/nonEmptyNotes"},
    "remediation_patterns": {"$ref": "#/$defs/nonEmptyNotes"},
    "regression_proof": {"$ref": "#/$defs/nonEmptyNotes"},
    "mapping_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}
    }
  },
  "$defs": {
    "nonEmptyNotes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 12, "maxLength": 500}
    }
  }
}
