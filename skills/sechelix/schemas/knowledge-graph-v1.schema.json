{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sechelix.dev/schemas/knowledge-graph-v1.schema.json",
  "title": "SecHelix security knowledge graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "updated_at", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "graph_id": {"type": "string", "pattern": "^KG-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "updated_at": {"type": "string", "format": "date-time"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "provenance", "source_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{2,95}$"},
          "type": {
            "enum": [
              "CWE", "CAPEC", "OWASP_TOP10", "OWASP_API_TOP10", "OWASP_LLM_TOP10",
              "OWASP_ASVS", "NIST_SSDF", "SECHELIX_FAMILY"
            ]
          },
          "label": {"type": "string", "minLength": 2, "maxLength": 180},
          "provenance": {"enum": ["EXTERNAL", "INTERNAL"]},
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "relation", "source_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^KGE-[A-Z0-9][A-Z0-9._-]{2,95}$"},
          "from": {"type": "string", "minLength": 3},
          "to": {"type": "string", "minLength": 3},
          "relation": {"enum": ["IS_EXPLOITED_BY", "INCLUDES", "MITIGATES", "CLASSIFIES_WITH", "RELATED_TO"]},
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}
          }
        }
      }
    }
  }
}
